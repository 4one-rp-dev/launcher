# --- обязательные ---
CORE_SECRET=              # случайная строка от 32 знаков (подпись формы входа)
CORE_PEPPER=              # ещё одна случайная строка (хеши токенов)
CORE_DB_USER=core_api
CORE_DB_PASSWORD=
# --- БД (одна: игровая) ---
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=3306
CORE_DB_NAME=ra3_main
# --- адреса ---
CORE_PUBLIC_URL=https://api.4onerp.com
CORE_HOST=127.0.0.1       # слушаем локально, наружу — через nginx с TLS
CORE_PORT=8787
CORE_TRUST_PROXY=1        # за nginx: брать IP из X-Forwarded-For
# --- сайт: адреса возврата после входа (через запятую); CORS включается для их источников ---
CORE_SITE_REDIRECTS=https://www.4onerp.com/auth/callback
# CORE_CORS_ORIGINS=https://admin.4onerp.com
# --- игровой сервер / cron шлёт онлайн серверов (от 16 знаков; пусто — маршрут выключен) ---
CORE_INTERNAL_TOKEN=
