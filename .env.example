# Переменные окружения для разработки (не коммитить .env)
# Демо-режим без сети: все ответы от встроенного мок-сервера
L4_MOCK=0
# Сценарий демо: login | ready | not-installed | update | no-gta | enhanced | offline | downloading | ingame
L4_MOCK_SCENARIO=ready
# Переопределения (по умолчанию из src/main/config.js)
# Адрес Core API (вход, профиль, роль). Для разработки: http://127.0.0.1:8787
# L4_CORE_URL=https://api.4onerp.com
# Статика: файлы клиента игры и обновления лаунчера
# L4_CDN_URL=https://cdn.4onerp.com
# L4_DEVTOOLS=1
